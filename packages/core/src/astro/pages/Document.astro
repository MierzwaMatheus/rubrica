---
/** Documento HTML de toda página pública: <head> do núcleo (SEO) e estilos do tema. */
import "virtual:rubrica/styles";
import { Font } from "astro:assets";
import { activeTheme, activeFontPlan, headOptions, loadSite } from "../runtime";
import { appearanceHead } from "../../theme/appearance";
import { fontPreloads } from "../../theme/fonts";
import { buildHead, renderHeadTags } from "../../seo/head";
import type { RenderContext } from "../../theme/contract";
import type { SiteSettings } from "../../content/types";
import type { SiteRoute } from "../../render/site";

interface Props {
  route: SiteRoute | { type: "notFound"; url: string; locale: string };
  ctx: RenderContext;
  settings: SiteSettings;
}
const { route, ctx, settings } = Astro.props;
const head = renderHeadTags(buildHead(route, settings, ctx, headOptions(await loadSite())));
const mode = settings.appearance.colorMode;
const look = appearanceHead(settings, activeTheme, activeFontPlan);
// Pré-carrega a fonte do texto e a de destaque do tema (títulos acima da dobra).
const preloads = fontPreloads(activeFontPlan);
---

<!doctype html>
<html lang={ctx.locale} data-color-mode={mode} data-theme-id={settings.theme} data-scheme={look.scheme} data-texture={look.texture}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={head} />
    {look.fonts.fonts.map((f) => <Font cssVariable={f.cssVariable as any} preload={preloads.has(f.cssVariable) ? [{ weight: preloads.get(f.cssVariable)!, style: "normal", subset: "latin" }] : false} />)}
    {look.css && <style set:html={look.css} />}
    {settings.appearance.colorToggle && <script is:inline src="/_rubrica/color-mode.js" />}
  </head>
  <body>
    <slot />
  </body>
</html>

---
import { useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const t = useDict(Astro.props.lang).features;
---

<section id="recursos" class="section">
  <div class="wrap feat">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="display">{t.title}</h2>
      <p>{t.intro}</p>
    </div>
    <dl class="list">
      {
        t.items.map((f) => (
          <div class="item">
            <dt>{f.title}</dt>
            <dd>{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    border-top: 1px solid var(--ink);
  }
  .item {
    padding: 22px 22px 26px 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 6px;
  }
  dt {
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 600;
    font-size: 27px;
    line-height: 1.1;
  }
  dd {
    margin: 0;
    color: var(--ink-2);
    font-size: 15.5px;
    max-width: 38ch;
  }
</style>

---
/*
 * Uma página de documentação: o .md de docs/ (ou o .en.md) renderizado no build,
 * com a navegação entre os docs à esquerda e o índice da página à direita.
 */
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { REPO } from "../lib/data";
import { docUrl, rewriteDoc } from "../lib/docs";
import { DOC_GROUPS, imageUrl, type Doc } from "../lib/docsContent";
import { renderMarkdown } from "../lib/markdown";
import { useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  doc: Doc;
}
const { lang, doc } = Astro.props;
const d = useDict(lang);
const t = d.docs;

const { html, toc } = renderMarkdown(
  rewriteDoc(doc.body[lang], { from: doc.file[lang], lang, repo: REPO, asset: imageUrl }),
);
const paths = { pt: docUrl(doc.slug, "pt"), en: docUrl(doc.slug, "en") };
const firstParagraph = doc.body[lang].match(/^(?:>\s*)?_?([^\n#<!|`].{20,}?)_?$/m)?.[1] ?? "";
const description = firstParagraph.replace(/[*_`[\]]|\([^)]*\)/g, "").slice(0, 160) || t.titleSuffix;
const groupLabel = { start: t.start, look: t.look, layouts: t.layouts };
---

<Base title={`${doc.title[lang]} — ${t.titleSuffix}`} description={description} lang={lang} page={paths}>
  <Header lang={lang} page={paths} />
  <div class="wrap docs">
    <nav class="lateral" aria-label={t.nav}>
      <details open>
        <summary class="eyebrow">{t.eyebrow}</summary>
        {
          DOC_GROUPS.map((g) => (
            <div class="grupo">
              <p class="grupo-nome">{groupLabel[g.key]}</p>
              <ul>
                {g.docs.map((x) => (
                  <li>
                    <a href={docUrl(x.slug, lang)} aria-current={x.slug === doc.slug ? "page" : undefined}>
                      {x.title[lang]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </details>
    </nav>

    <main class="artigo">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display">{doc.title[lang]}</h1>
      {t.translationNote && <p class="nota">{t.translationNote}</p>}
      <div class="md" set:html={html} />
      <p class="editar">
        <a href={`${REPO}/blob/main/${doc.file[lang]}`} target="_blank" rel="noopener">{t.edit}</a>
      </p>
    </main>

    {
      toc.length > 1 && (
        <aside class="indice" aria-label={t.onThisPage}>
          <p class="eyebrow">{t.onThisPage}</p>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
  <Footer lang={lang} />
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 200px;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding-block: clamp(40px, 6vw, 72px) clamp(64px, 9vw, 112px);
  }

  .lateral,
  .indice {
    position: sticky;
    top: 92px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    scrollbar-width: thin;
    font-size: 14px;
  }
  .lateral summary {
    list-style: none;
    pointer-events: none;
    margin-bottom: 14px;
  }
  .lateral summary::-webkit-details-marker {
    display: none;
  }
  .grupo + .grupo {
    margin-top: 20px;
  }
  .grupo-nome {
    font-weight: 600;
    margin-bottom: 6px;
  }
  .lateral ul,
  .indice ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .lateral a,
  .indice a {
    display: block;
    padding: 4px 0 4px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.4;
  }
  .lateral a:hover,
  .indice a:hover {
    color: var(--terracota-ink);
  }
  .lateral a[aria-current="page"] {
    border-left-color: var(--terracota);
    color: var(--ink);
    font-weight: 600;
  }
  .indice .eyebrow {
    margin-bottom: 10px;
  }

  .artigo {
    min-width: 0;
  }
  .artigo h1 {
    margin: 10px 0 18px;
    font-size: clamp(40px, 5.6vw, 68px);
  }
  .nota {
    margin-bottom: 24px;
    padding-left: 12px;
    border-left: 2px solid var(--salvia);
    font-size: 14.5px;
    color: var(--ink-3);
  }
  .editar {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .editar a {
    color: var(--terracota-ink);
  }

  .md {
    color: var(--ink-2);
    max-width: 78ch;
  }
  .md :global(:is(p, ul, ol, pre, blockquote, table)) {
    margin: 0 0 16px;
  }
  .md :global(h2) {
    margin: 44px 0 14px;
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 36px);
    line-height: 1.1;
    color: var(--ink);
  }
  .md :global(h3) {
    margin: 30px 0 10px;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .md :global(h4) {
    margin: 22px 0 8px;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }
  .md :global(:is(h2, h3, h4)) {
    scroll-margin-top: 88px;
  }
  .md :global(ul),
  .md :global(ol) {
    padding-left: 22px;
  }
  .md :global(li) {
    margin-bottom: 6px;
  }
  .md :global(li::marker) {
    color: var(--terracota);
  }
  .md :global(strong) {
    color: var(--ink);
  }
  .md :global(a) {
    color: var(--terracota-ink);
  }
  .md :global(blockquote) {
    padding-left: 14px;
    border-left: 2px solid var(--line-strong);
    color: var(--ink-3);
    font-size: 18px;
  }
  .md :global(code) {
    font-family: var(--f-mono);
    font-size: 0.86em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--paper-2);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .md :global(pre) {
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .md :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
    overflow-wrap: normal;
  }
  .md :global(img) {
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .md :global(p > img:only-child) {
    display: block;
    width: 100%;
  }
  .md :global(sub) {
    display: block;
    margin-top: -6px;
    font-size: 13px;
    color: var(--ink-3);
    vertical-align: baseline;
  }
  .md :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .md :global(th),
  .md :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .md :global(th) {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--line-strong);
  }
  .md :global(td img) {
    max-width: 220px;
  }
  .md :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 32px 0;
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 210px minmax(0, 1fr);
    }
    .indice {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .lateral {
      position: static;
      max-height: none;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
    }
    .lateral summary {
      pointer-events: auto;
      cursor: pointer;
      margin-bottom: 0;
    }
    .lateral details[open] summary {
      margin-bottom: 14px;
    }
    .md :global(td img) {
      max-width: 140px;
    }
  }
</style>

<script>
  // No celular a navegação começa fechada.
  if (matchMedia("(max-width: 820px)").matches) document.querySelector(".lateral details")?.removeAttribute("open");
</script>

---
/**
 * Toda página pública: páginas com blocos, posts e cases, em cada idioma em que
 * existem. Componentes React do tema renderizados em HTML estático; só as ilhas
 * levam JavaScript.
 */
import type { GetStaticPaths } from "astro";
import Document from "./Document.astro";
import ContactDialog from "./ContactDialog.astro";
import Blocks from "./Blocks.astro";
import Island from "../../islands/Island";
import { loadSite, activeTheme, activeFontPlan, caseCarouselProps } from "../runtime";
import { templates, LocaleLinks, ColorToggleButton } from "../../components";
import type { SiteRoute } from "../../render/site";
import { brandCss } from "../../theme/brand";
import { routeFontVars } from "../../theme/fonts";

export const getStaticPaths = (async () => {
  const site = await loadSite();
  return site.routes.map((route) => ({
    params: { path: route.url === "/" ? undefined : route.url.slice(1) },
    props: { route },
  }));
}) satisfies GetStaticPaths;

const { route } = Astro.props as { route: SiteRoute };
const site = await loadSite();
const ctx = site.context(route.locale, route.url, route.alternates);
const { Shell, Post, Case } = templates(activeTheme);
const pageType = route.type;
const carousel = route.type === "case" ? caseCarouselProps(route.project, ctx) : undefined;
// Case com a cara do cliente: o CSS das cores (escopo `[data-rb-brand]`) vai no <head>.
const brand = route.type === "case" ? route.brand : undefined;
// Fontes de conteúdo que a rota usa (blocos tipografia, fonte do cliente): só elas no <head>.
const bodyBlocks = route.type === "page" ? route.page.blocks : route.type === "case" ? route.blocks : [];
const fontVars = routeFontVars(activeFontPlan, bodyBlocks, brand?.fontDisplay);
const caseBody = route.type === "case" && route.blocks.length > 0;
---

<Document route={route} ctx={ctx} settings={site.settings} fontVars={fontVars} css={brand && brandCss(brand)}>
  <Shell ctx={ctx} pageType={pageType} collections={site.collections(route.locale)}>
    <LocaleLinks slot="localeSwitcher" ctx={ctx} />
    {ctx.site.colorToggle && <ColorToggleButton slot="colorToggle" label={ctx.t("theme.toggle")} />}
    {
      route.type === "page" && (
        <>
          {route.page.needsHiddenH1 && <h1 class="rb-sr-only">{route.page.title}</h1>}
          <Blocks blocks={route.page.blocks} ctx={ctx} context="page" />
        </>
      )
    }
    {route.type === "post" && <Post post={route.post} html={route.post.content} related={route.related} relatedCase={route.relatedCase} ctx={ctx} />}
    {
      route.type === "case" &&
        (brand ? (
          <div data-rb-brand data-rb-brand-font={brand.fontDisplay ? "" : undefined} class="rb-case-brand">
            <Case project={route.project} related={route.related} next={route.next} brand={brand} ctx={ctx}>
              {carousel && <Island slot="carousel" client:visible name="carrossel" props={carousel} />}
              {caseBody && <Blocks slot="blocks" blocks={route.blocks} ctx={ctx} context="case" />}
            </Case>
          </div>
        ) : (
          <Case project={route.project} related={route.related} next={route.next} ctx={ctx}>
            {carousel && <Island slot="carousel" client:visible name="carrossel" props={carousel} />}
            {caseBody && <Blocks slot="blocks" blocks={route.blocks} ctx={ctx} context="case" />}
          </Case>
        ))
    }
  </Shell>
  <ContactDialog site={site} ctx={ctx} />
</Document>

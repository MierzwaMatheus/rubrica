---
import { LAYOUTS, SCHEMES, SANS_FONTS, MONO_FONTS, TEXTURES, MOODS, PAGES } from "../lib/data";
import { useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const d = useDict(Astro.props.lang);
const t = d.combinator;
const cat = d.catalog;

const newLayouts = LAYOUTS.filter((l) => !l.legacy);
const legacyLayouts = LAYOUTS.filter((l) => l.legacy);
const schemeById = Object.fromEntries(SCHEMES.map((s) => [s.id, s]));
const config = {
  layouts: LAYOUTS.map((l) => ({ id: l.id, label: l.label, recommended: l.recommended, fonts: l.fonts })),
  schemes: SCHEMES.map((s) => ({ id: s.id, label: s.label })),
  moods: MOODS,
  pages: PAGES.map((path) => ({ path, label: d.pages[path] })),
  i18n: {
    rows: t.rows,
    light: t.light,
    dark: t.dark,
    textures: Object.fromEntries(TEXTURES.map((x) => [x.value, cat.textures[x.value].label])),
  },
};
---

<section id="combinador" class="section combinator">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="display">{t.title}</h2>
      <p>{t.intro}{t.previewNote && <> {t.previewNote}</>}</p>
    </div>

    <div class="lab">
      <form class="controls" id="cb-controls" aria-label={t.controlsAria}>
        <fieldset class="grp">
          <legend>{t.moods}</legend>
          <p class="help">{t.moodsHelp}</p>
          <div class="chips">
            {
              MOODS.map((m) => {
                const s = schemeById[m.scheme][m.mode];
                return (
                  <button type="button" class="chip mood" data-mood={m.id} aria-pressed="false">
                    <span class="dots" aria-hidden="true">
                      <i style={`background:${s.bg}`} />
                      <i style={`background:${s.primary}`} />
                      <i style={`background:${s.accent}`} />
                    </span>
                    {cat.moods[m.id]}
                  </button>
                );
              })
            }
          </div>
        </fieldset>

        <fieldset class="grp">
          <legend>{t.layout}</legend>
          <p class="sub">{t.newLayouts}</p>
          <div class="chips">
            {newLayouts.map((l) => <button type="button" class="chip" data-layout={l.id} aria-pressed="false" title={cat.layoutHints[l.id]}>{l.label}</button>)}
          </div>
          <p class="sub">{t.legacyLayouts}</p>
          <div class="chips">
            {legacyLayouts.map((l) => <button type="button" class="chip" data-layout={l.id} aria-pressed="false" title={cat.layoutHints[l.id]}>{l.label}</button>)}
          </div>
        </fieldset>

        <fieldset class="grp">
          <legend>{t.scheme}</legend>
          <p class="help">{t.schemeHelp}</p>
          <div class="schemes">
            {
              SCHEMES.map((s) => (
                <button type="button" class="scheme" data-scheme={s.id} aria-pressed="false" title={cat.schemeHints[s.id]}>
                  <span class="sw" aria-hidden="true">
                    <i style={`background:${s.light.bg}`} />
                    <i style={`background:${s.light.primary}`} />
                    <i style={`background:${s.light.accent}`} />
                    <i style={`background:${s.dark.bg}`} />
                  </span>
                  <span class="nm">{s.label}</span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <div class="row2">
          <fieldset class="grp">
            <legend>{t.mode}</legend>
            <div class="seg">
              <button type="button" data-mode="light" aria-pressed="false">{t.light}</button>
              <button type="button" data-mode="dark" aria-pressed="false">{t.dark}</button>
            </div>
          </fieldset>
          <fieldset class="grp">
            <legend>{t.toggle}</legend>
            <div class="seg">
              <button type="button" data-toggle="1" aria-pressed="false">{t.show}</button>
              <button type="button" data-toggle="0" aria-pressed="false">{t.hide}</button>
            </div>
          </fieldset>
        </div>

        <fieldset class="grp">
          <legend>{t.texture}</legend>
          <div class="seg wrap4">
            {TEXTURES.map((x) => <button type="button" data-texture={x.value} aria-pressed="false" title={cat.textures[x.value].hint}>{cat.textures[x.value].label}</button>)}
          </div>
        </fieldset>

        <div class="row2">
          <label class="grp">
            <span class="lbl">{t.sans}</span>
            <select id="cb-sans">
              {SANS_FONTS.map((f) => <option value={f.family}>{f.family}</option>)}
            </select>
          </label>
          <label class="grp">
            <span class="lbl">{t.mono}</span>
            <select id="cb-mono">
              {MONO_FONTS.map((f) => <option value={f.family}>{f.family}</option>)}
            </select>
          </label>
        </div>
      </form>

      <div class="monitor">
        <div class="frame">
          <div class="bar">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="tabs" role="tablist" aria-label={t.pageTabs}>
              {PAGES.map((p) => <button type="button" role="tab" data-page={p} aria-selected="false">{d.pages[p]}</button>)}
            </div>
            <div class="tools">
              <div class="seg small" aria-label={t.screenSize}>
                <button type="button" data-device="desktop" aria-pressed="true">{t.desktop}</button>
                <button type="button" data-device="mobile" aria-pressed="false">{t.mobile}</button>
              </div>
              <a id="cb-open" class="open" href="#" target="_blank" rel="noopener" aria-label={t.openFull}>
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M9 2h5v5M14 2 7.5 8.5M12 9.5V14H2V4h4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
            </div>
          </div>
          <div class="stage" id="cb-stage" data-device="desktop">
            <iframe id="cb-frame" title={t.frameTitle} loading="lazy"></iframe>
            <div class="loading" id="cb-loading" aria-hidden="true"><span>{t.loading}</span></div>
          </div>
        </div>

        <div class="answers">
          <div>
            <p class="eyebrow">{t.answers}</p>
            <dl id="cb-answers"></dl>
          </div>
          <a class="btn" href="#criar">{t.createCta}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="cb-config" set:html={JSON.stringify(config)} />

<script>
  import { initCombinator } from "../lib/combinator";
  initCombinator();
</script>

<style>
  .combinator {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }
  .lab {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .controls {
    display: grid;
    gap: 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 108px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .grp {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
    min-width: 0;
  }
  legend,
  .lbl {
    padding: 0;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 9px;
  }
  .lbl {
    margin-bottom: 0;
  }
  .help {
    font-size: 13px;
    color: var(--ink-3);
    margin-top: -4px;
  }
  .sub {
    font-size: 12.5px;
    color: var(--ink-2);
    font-weight: 600;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip,
  .seg button,
  .tabs button {
    font: 500 13px/1.2 var(--f-body);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 6px 11px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .chip:hover,
  .seg button:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed="true"],
  .seg button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .dots,
  .sw {
    display: inline-flex;
  }
  .dots i,
  .sw i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid rgb(26 26 24 / 0.18);
    margin-right: -3px;
  }
  .schemes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .scheme {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 9px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    font: 500 13px/1.2 var(--f-body);
    color: var(--ink);
    cursor: pointer;
    text-align: left;
  }
  .scheme:hover {
    border-color: var(--ink-3);
  }
  .scheme[aria-pressed="true"] {
    border-color: var(--terracota);
    box-shadow: inset 0 0 0 1px var(--terracota);
    background: var(--terracota-wash);
  }
  .nm {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .seg {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  select {
    width: 100%;
    font: 500 14px/1.2 var(--f-body);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: 8px 10px;
  }

  .monitor {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    min-width: 0;
  }
  .frame {
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .tabs {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .tabs button {
    border-color: transparent;
    padding: 5px 10px;
  }
  .tabs button[aria-selected="true"] {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .seg.small button {
    padding: 4px 10px;
    font-size: 12.5px;
  }
  .open {
    display: inline-flex;
    padding: 6px;
    border-radius: 6px;
    color: var(--ink-2);
  }
  .open:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .stage {
    position: relative;
    height: min(78vh, 760px);
    overflow: hidden;
    background: var(--paper-3);
  }
  .stage iframe {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    background: var(--paper);
    transform-origin: 0 0;
  }
  .stage[data-device="mobile"] iframe {
    left: 50%;
    border-left: 1px solid var(--line-strong);
    border-right: 1px solid var(--line-strong);
  }
  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--paper-3) 70%, transparent);
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--ink-2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .loading.on {
    opacity: 1;
  }
  .answers {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: end;
    justify-content: space-between;
  }
  .answers dl {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 8px 0 0;
    font-size: 14px;
  }
  .answers :global(dl div) {
    display: flex;
    gap: 6px;
  }
  .answers :global(dt) {
    color: var(--ink-3);
  }
  .answers :global(dd) {
    margin: 0;
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .lab {
      grid-template-columns: minmax(0, 1fr);
    }
    .controls {
      position: static;
      max-height: none;
    }
    .monitor {
      order: -1;
    }
    .stage {
      height: min(70vh, 640px);
    }
  }
  @media (max-width: 560px) {
    .tools .seg {
      display: none;
    }
    .schemes {
      grid-template-columns: 1fr;
    }
  }
</style>

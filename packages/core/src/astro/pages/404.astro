---
/** 404 no idioma principal (a hospedagem serve dist/404.html com status 404). */
import Document from "./Document.astro";
import { loadSite, activeTheme } from "../runtime";
import { templates, LocaleLinks, ColorToggleButton } from "../../components";
import { localizedPath } from "../../i18n";

const site = await loadSite();
const locale = site.settings.locales.default;
const url = localizedPath("/404", locale, site.settings.locales);
const ctx = site.context(locale, url);
const { Shell, NotFound } = templates(activeTheme);
---

<Document route={{ type: "notFound", url, locale }} ctx={ctx} settings={site.settings}>
  <Shell ctx={ctx} pageType="notFound" collections={site.collections(locale)}>
    <LocaleLinks slot="localeSwitcher" ctx={ctx} />
    {ctx.site.colorToggle && <ColorToggleButton slot="colorToggle" label={ctx.t("theme.toggle")} />}
    <NotFound ctx={ctx} />
  </Shell>
</Document>

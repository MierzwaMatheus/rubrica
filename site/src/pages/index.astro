---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Combinator from "../components/Combinator.astro";
import CreateYours from "../components/CreateYours.astro";
import Layouts from "../components/Layouts.astro";
import Schemes from "../components/Schemes.astro";
import Features from "../components/Features.astro";
import Start from "../components/Start.astro";
import Creator from "../components/Creator.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Rubrica — portfólio profissional open source"
  description="Home, portfólio, blog, currículo, propostas e painel admin prontos. 13 layouts e 15 esquemas de cores com modo claro e escuro. Assine com a sua cara."
>
  <Header />
  <main>
    <Hero />
    <Combinator />
    <CreateYours />
    <Layouts />
    <Schemes />
    <Features />
    <Start />
    <Creator />
  </main>
  <Footer />
</Base>

<script>
  // Botões "Copiar" da página inteira.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    const text = btn.dataset.copy ?? "";
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = "Copiado";
    } catch {
      const range = document.createRange();
      range.selectNodeContents(btn.previousElementSibling ?? btn);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
      btn.textContent = "Selecionado";
    }
    setTimeout(() => (btn.textContent = "Copiar"), 1600);
  });
</script>

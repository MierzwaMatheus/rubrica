---
import "../styles/global.css";
import { HTML_LANG, LANGS, route, type Lang, type PageKey } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  /** Idioma da página. */
  lang: Lang;
  /** Qual página é esta: liga as versões em português e em inglês (hreflang). */
  page: PageKey;
  /** Página fora dos buscadores (ex.: a entrevista de voz). */
  noindex?: boolean;
}
const { title, description, lang, page, noindex = false } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={abs(route(page, lang))} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(route(page, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(route(page, "pt"))} />
    <meta property="og:locale" content={HTML_LANG[lang].replace("-", "_")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/capa.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#C4664A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

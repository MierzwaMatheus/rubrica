---
import { STEP_CODES, REPO } from "../lib/data";
import { useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const d = useDict(Astro.props.lang);
const t = d.start;
const steps = t.steps.map((s, i) => ({ ...s, code: STEP_CODES[i] }));
---

<section id="comecar" class="section start">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="display">{t.title}</h2>
      <p>{t.introBefore} <code>update</code> {t.introAfter}</p>
    </div>
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <div class="cmd">
              <code>{s.code}</code>
              <button class="copy" type="button" data-copy={s.code}>{d.common.copy}</button>
            </div>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="more">
      {t.moreBefore}{" "}
      <a href={`${REPO}#readme`} target="_blank" rel="noopener">README</a>.
    </p>
  </div>
</section>

<style>
  .section-head code {
    font-family: var(--f-mono);
    font-size: 0.9em;
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    min-width: 0;
  }
  .steps li::before {
    content: counter(step);
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 600;
    font-size: 44px;
    line-height: 0.8;
    color: var(--terracota);
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
  }
  .steps p {
    color: var(--ink-2);
    font-size: 15px;
  }
  .steps .cmd {
    display: flex;
    width: 100%;
    min-width: 0;
  }
  .more {
    margin-top: 32px;
    color: var(--ink-2);
  }
  .more a {
    color: var(--terracota-ink);
    text-underline-offset: 3px;
  }
</style>

---
/** Documento HTML de toda página pública: <head> do núcleo (SEO) e estilos do tema. */
import "virtual:rubrica/styles";
import { Font } from "astro:assets";
import { activeTheme, activeFontPlan } from "../runtime";
import { appearanceHead } from "../../theme/appearance";
import { buildHead, renderHeadTags } from "../../seo/head";
import type { RenderContext } from "../../theme/contract";
import type { SiteSettings } from "../../content/types";
import type { SiteRoute } from "../../render/site";

interface Props {
  route: SiteRoute | { type: "notFound"; url: string; locale: string };
  ctx: RenderContext;
  settings: SiteSettings;
}
const { route, ctx, settings } = Astro.props;
const head = renderHeadTags(buildHead(route, settings, ctx));
const mode = settings.appearance.colorMode;
const look = appearanceHead(settings, activeTheme, activeFontPlan);
// Só a fonte do texto é pré-carregada (peso 400): o resto carrega quando for usado.
const preloadVar = activeFontPlan.assign["--rb-font-sans"];
---

<!doctype html>
<html lang={ctx.locale} data-color-mode={mode} data-theme-id={settings.theme} data-scheme={look.scheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={head} />
    {look.fonts.fonts.map((f) => <Font cssVariable={f.cssVariable as any} preload={f.cssVariable === preloadVar ? [{ weight: "400", style: "normal", subset: "latin" }] : false} />)}
    {look.css && <style set:html={look.css} />}
    {settings.appearance.colorToggle && <script is:inline src="/_rubrica/color-mode.js" />}
  </head>
  <body>
    <slot />
  </body>
</html>

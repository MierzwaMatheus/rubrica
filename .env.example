# =============================================================================
# FRONTEND E BUILD (.env.local) — lidas pelo Vite e pelos scripts de build.
# O `npx convex dev` cria o .env.local com VITE_CONVEX_URL e VITE_CONVEX_SITE_URL.
# Na Vercel, cadastre estas em Settings → Environment Variables.
# =============================================================================

# URL do deployment Convex (obrigatória)
VITE_CONVEX_URL=https://seu-deployment.convex.cloud

# Mesma URL, usada pelos scripts de build (dados estáticos, RSS, sitemap, textos)
CONVEX_URL=https://seu-deployment.convex.cloud

# Chave de deploy do Convex: o build roda `convex deploy` (obrigatória na Vercel)
CONVEX_DEPLOY_KEY=

# URL pública do site: RSS, sitemap e links absolutos
SITE_URL=https://seusite.com

# Umami (opcional). Sem as duas, o script de analytics não é incluído.
# Umami Cloud já está liberado no CSP; para Umami próprio, acrescente o domínio
# em script-src e connect-src no vercel.json.
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# VITE_UMAMI_WEBSITE_ID=


# =============================================================================
# SERVIDOR CONVEX — não vão no .env.local. Configure com:
#   npx convex env set NOME valor
# O `create-rubrica setup` configura as obrigatórias e as dos plugins ligados.
# =============================================================================

# --- Obrigatórias ---
# Chaves do login (geradas pelo setup)
# JWT_PRIVATE_KEY=
# JWKS=
# URL pública do site (links nos e-mails e notificações, CORS, retorno do pagamento).
# Para o retorno após o cartão, o domínio também precisa estar cadastrado no Asaas
# (Minha Conta → Informações).
# SITE_URL=https://seusite.com

# --- Primeiro acesso ---
# Libera a criação do usuário root. Use só no setup inicial e remova depois.
# BOOTSTRAP_ALLOWED=true

# --- Pagamentos (plugin payments) ---
# Chave da API do Asaas. Começa com $aact_hmlg_ (sandbox) ou $aact_prod_ (produção);
# o ambiente é detectado pela chave.
# ASAAS_API_KEY=
# Token do webhook: o mesmo cadastrado no painel do Asaas (Integrações → Webhooks),
# com a URL https://<seu-deployment>.convex.site/webhooks/asaas
# ASAAS_WEBHOOK_TOKEN=
# Opcional: força o ambiente (production | sandbox)
# ASAAS_ENV=

# --- Notificações no Telegram (contato, depoimentos, propostas, pagamentos) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# --- IA (plugins ai-resumes, i18n e playground) ---
# OPENROUTER_API_KEY=

# --- Playground: pepper das chaves de API (gerado pelo setup) ---
# PLAYGROUND_KEY_PEPPER=

# --- Botão "Publicar" do admin ---
# Deploy hook da Vercel (Settings → Git → Deploy Hooks)
# VERCEL_DEPLOY_HOOK_URL=
# Segredo do webhook que avisa o fim do deploy (/webhooks/vercel-deploy)
# VERCEL_WEBHOOK_SECRET=

{
  "name": "@rubrica/mcp",
  "version": "2.0.2",
  "description": "Servidor MCP local do Rubrica: o agente edita páginas, blocos e coleções do site pelo Convex do projeto, com o login de um usuário do painel.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MierzwaMatheus/rubrica.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rubrica-mcp": "./bin/rubrica-mcp.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.17.1",
    "convex": "^1.50.0"
  },
  "devDependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@edge-runtime/vm": "^5.0.0",
    "@rubrica/core": "workspace:^",
    "@types/node": "^22.0.0",
    "convex-test": "^0.0.67",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}

{
  "name": "rubrica-site",
  "private": true,
  "type": "module",
  "description": "Site público e documentação do Rubrica, com o combinador de temas e esquemas.",
  "scripts": {
    "previews": "tsx scripts/build-previews.ts",
    "dev": "astro dev",
    "build": "astro build && pnpm links",
    "build:full": "pnpm previews && astro build && pnpm links",
    "preview": "astro preview",
    "docs:blocos": "tsx --tsconfig scripts/tsconfig.json scripts/blocos.ts",
    "test": "tsx --tsconfig scripts/tsconfig.json --test scripts/*.test.ts",
    "check": "tsx --tsconfig scripts/tsconfig.json scripts/exemplos.ts",
    "links": "tsx --tsconfig scripts/tsconfig.json scripts/links-dist.ts"
  },
  "dependencies": {
    "astro": "7.4.1",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@rubrica/core": "workspace:^",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "convex": "^1.50.0",
    "react": "^19.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@rubrica/theme-tester",
  "version": "2.0.0-alpha.0",
  "description": "Bateria de testes de tema do Rubrica (axe, SEO, JavaScript por página, Lighthouse).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rubrica-testar-tema": "./bin/rubrica-testar-tema.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["bin", "src"],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@rubrica/theme-desktop",
  "version": "2.0.0-alpha.0",
  "description": "Tema desktop do Rubrica (layout Desktop Retrô da v1): cada seção é uma janela sobre a área de trabalho, com barra de menu e ícones.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MierzwaMatheus/rubrica.git",
    "directory": "packages/themes/desktop"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./src/styles.css",
    "./fonts.json": "./src/fonts.json"
  },
  "files": ["src"],
  "rubrica": { "contract": "^1" },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@rubrica/core": "workspace:^",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@rubrica/core": "workspace:^",
    "@types/react": "^19.2.0",
    "react": "^19.2.1",
    "typescript": "^5.9.0"
  }
}

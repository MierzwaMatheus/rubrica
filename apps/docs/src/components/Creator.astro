---
import { useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const t = useDict(Astro.props.lang).creator;
const links = [
  { href: "https://www.mmlo.com.br", label: "mmlo.com.br", note: t.portfolioNote },
  { href: "https://github.com/MierzwaMatheus", label: "GitHub", note: "@MierzwaMatheus" },
];
---

<section id="criador" class="section creator">
  <div class="wrap grid">
    <div class="mark">
      <picture>
        <source srcset="/img/matheus.webp" type="image/webp" />
        <img src="/img/matheus.jpg" alt={t.photoAlt} width="720" height="720" loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="text">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="display">Matheus Mierzwa</h2>
      <p class="role">{t.role}</p>
      {t.bio.map((p) => <p>{p}</p>)}
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
              <span>{l.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .mark {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #0d1420;
    border: 1px solid var(--line);
    box-shadow: 0 0 0 10px var(--card);
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }
  .mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    display: grid;
    gap: 16px;
    max-width: 62ch;
  }
  h2 {
    font-size: clamp(44px, 6vw, 72px);
  }
  .role {
    font-family: var(--f-mono);
    font-size: 13.5px;
    color: var(--salvia);
    margin-top: -6px;
  }
  .text > p:not(.eyebrow):not(.role) {
    color: var(--ink-2);
    font-size: 17px;
  }
  .links {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
  }
  .links li {
    display: grid;
  }
  .links a {
    font-weight: 600;
    color: var(--terracota-ink);
    text-underline-offset: 3px;
  }
  .links span {
    font-size: 13.5px;
    color: var(--ink-3);
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .mark {
      max-width: 220px;
    }
  }
</style>
